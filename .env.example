# Default model to use (must exist in providers.json).
# Ollama examples: "gemma4:latest", "qwen3:4b", "mistral:7b"
# Gemini examples: "gemini-2.5-pro", "gemini-2.5-flash"
DEFAULT_MODEL=gemma4:latest

# API keys — only needed for providers whose api_key_env is set in providers.json.
GEMINI_API_KEY=your_gemini_api_key_here

# Phase 0 — PDF integrity (warn-only by default)
ENABLE_PDF_INTEGRITY=true
BLOCK_ON_PDF_INTEGRITY_FAIL=false

# Phase 1 — Score validation (set 3 for multi-run confidence; 3× eval cost)
ENSEMBLE_RUNS=1

# Phase 2 — Writing quality (spell check on by default; LLM grammar off)
ENABLE_WRITING_QUALITY=true
WRITING_QUALITY_USE_LLM=false

# Phase 3 — Blog enrichment (HTTP fetch on; LLM blog scoring off)
ENABLE_BLOG_ENRICHMENT=true
ENABLE_BLOG_LLM_SCORING=false

# Phase 4 — Batch ranking default cutoff (bottom percentile filtered)
BATCH_CUTOFF_PERCENTILE=15

# Web report (HTML output in reports/)
ENABLE_WEB_REPORT=true
WEB_REPORT_OUTPUT_DIR=reports
ENABLE_REPORT_LLM=false
