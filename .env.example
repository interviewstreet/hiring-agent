# Default model to use (must exist in providers.json).
# OpenRouter default: "google/gemini-3.1-pro-preview" (preview model)
# OpenRouter alternative: "google/gemini-3.8-flash"
# Ollama examples: "gemma4:latest", "qwen3:4b", "mistral:7b"
# Direct Gemini examples: "gemini-2.5-pro", "gemini-2.5-flash"
# OpenAI example: "gpt-6-luna"
DEFAULT_MODEL=google/gemini-3.1-pro-preview

# Reuse OPENROUTER_API_KEY exported in your shell (e.g. the key used by Pi).
# No need to duplicate the key here; shell variables take precedence over .env.
# If it is not exported, set it in your untracked .env, never in this template.
# OPENROUTER_API_KEY=your_openrouter_api_key_here

# API keys — only needed for providers whose api_key_env is set in providers.json.
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
