# Default model to use (must exist in providers.json).
# Ollama examples:  "gemma4:latest", "qwen3:4b", "mistral:7b"
# Gemini examples:  "gemini-2.5-pro", "gemini-2.5-flash"
# Bedrock examples: "us.anthropic.claude-haiku-4-5-20251001-v1:0", "amazon.nova-pro-v1:0"
DEFAULT_MODEL=gemma4:latest

# API keys — only needed for providers whose api_key_env is set in providers.json.
GEMINI_API_KEY=your_gemini_api_key_here

# AWS Bedrock uses SigV4 from the standard credential chain, so there is no API
# key. Configure credentials with `aws configure`, an AWS_PROFILE, or an
# instance/task role. Only the region is read here, and it overrides the
# "region" declared for the bedrock provider in providers.json.
AWS_REGION=us-east-1

# Optional. Improves GitHub API rate limits from 60/hr to 5000/hr. Enrichment
# makes roughly one request per public repo, so a candidate with many repos will
# exhaust the unauthenticated limit and stall.
# GITHUB_TOKEN=your_github_token_here
